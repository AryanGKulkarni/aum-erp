# Copy this file to the server as ".env" (same directory as docker-compose-server.yml),
# then fill in the real values. Do not commit the filled-in version.

NODE_ENV=production

# --- Postgres (container, service name "postgres" on the compose network) ---
POSTGRES_DB=aum_erp
POSTGRES_USER=aum_user
POSTGRES_PASSWORD=<pick a strong password>

# --- Backend ---
PORT=3000

# IMPORTANT: env_file values are NOT variable-expanded by Docker Compose — ${VAR}
# only works when written directly in the compose YAML, not inside a .env file's
# own values. So the user/password/db name below must be typed out literally and
# kept in sync by hand with POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB above.
# Host is the compose service name "postgres", not localhost or an RDS endpoint.
DATABASE_URL=postgresql://aum_user:<same password as POSTGRES_PASSWORD>@postgres:5432/aum_erp

JWT_SECRET=<generate a long random string, e.g. `openssl rand -hex 32`>

# Public URLs, routed through nginx (backend sits behind the /api/ prefix, see nginx/default.conf)
APP_URL=https://yourdomain.com/api
FRONTEND_URL=https://yourdomain.com

# --- SMTP (magic-link login emails) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=<app password>
SMTP_FROM=you@example.com

# --- Google OAuth ---
# Authorized redirect URI in Google Cloud Console must match GOOGLE_CALLBACK_URL exactly.
GOOGLE_CLIENT_ID=<from Google Cloud Console>
GOOGLE_CLIENT_SECRET=<from Google Cloud Console>
GOOGLE_CALLBACK_URL=https://yourdomain.com/api/auth/google/callback

# NOTE: NEXT_PUBLIC_API_URL is intentionally NOT here. Next.js inlines it into
# the frontend bundle at BUILD time, not at container start — putting it in
# this file has no effect. It must be passed as a --build-arg (e.g.
# https://yourdomain.com/api) when the frontend image is built in CI.
